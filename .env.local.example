# Firebase Configuration
# Copy this file to .env.local and fill in your Firebase project credentials.
# Get these values from: https://console.firebase.google.com > Project Settings > General

NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Gemini API (Optional - enables AI features: Signal Judge, Recon Report, Estate Advisor)
# Get your key from: https://aistudio.google.com/apikey
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key
