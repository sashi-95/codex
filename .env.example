# Zendesk Configuration
# Your Zendesk subdomain (e.g., if your URL is mycompany.zendesk.com, use 'mycompany')
ZENDESK_SUBDOMAIN=your-subdomain

# Zendesk account email address
ZENDESK_EMAIL=your-email@example.com

# Zendesk API token (generate from Admin Center > Apps and integrations > APIs > Zendesk API)
ZENDESK_API_TOKEN=your-api-token

# AI Service Configuration (choose ONE)
# OpenAI API Key (for GPT-4)
OPENAI_API_KEY=sk-your-openai-key

# OR Anthropic API Key (for Claude)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Existing Configuration (from IMPLEMENTATION_GUIDE.md)
# Snowflake Data Warehouse
SNOWFLAKE_API_URL=your-snowflake-url
SNOWFLAKE_API_KEY=your-snowflake-key
SNOWFLAKE_ACCOUNT=your-snowflake-account

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
